# Vismay environment configuration.
# Copy this file to `.env` and fill in the values you need.
# In the Z.ai sandbox the AI provider is pre-authenticated by the runtime;
# in a self-hosted deployment you MUST set the API keys below.

# ---------------------------------------------------------------------------
# Database (SQLite file in the sandbox; swap for PostgreSQL/Supabase in prod)
# ---------------------------------------------------------------------------
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ---------------------------------------------------------------------------
# AI provider (z-ai-web-dev-sdk by default; OpenAI / Gemini also supported)
# ---------------------------------------------------------------------------
# Optional in the sandbox; required in self-hosted deployments.
ZAI_API_KEY=
ZAI_BASE_URL=

# To use OpenAI instead, set:
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Web search & source retrieval
# ---------------------------------------------------------------------------
# The sandbox SDK provides web_search + page_reader out of the box.
# For self-hosted deployments, configure a search provider here.
SEARCH_PROVIDER=zai  # zai | tavily | serper | brave
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=

# ---------------------------------------------------------------------------
# Uploads (sandbox uses local disk; production should use Supabase storage)
# ---------------------------------------------------------------------------
UPLOADS_DIR=/home/z/my-project/uploads
# Supabase (production):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=vismay-uploads

# ---------------------------------------------------------------------------
# Auth (sandbox uses a single demo user; production should use Supabase Auth)
# ---------------------------------------------------------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
